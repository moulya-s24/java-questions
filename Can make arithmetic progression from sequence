import java.util.Arrays;
import java.util.HashSet;
import java.util.Set;
public class Main {
   public static void main(String[] args) {
       Solution solution = new Solution();
       int[] arr1 = {3, 5, 1};
       System.out.println("Array: " + Arrays.toString(arr1));
       System.out.println("Can make AP: " + solution.canMakeArithmeticProgression(arr1) + "\n");
       int[] arr2 = {1, 2, 4};
       System.out.println("Array: " + Arrays.toString(arr2));
       System.out.println("Can make AP: " + solution.canMakeArithmeticProgression(arr2));
   }
}
class Solution {
   public boolean canMakeArithmeticProgression(int[] arr) {
       int n = arr.length;
       int min = Integer.MAX_VALUE;
       int max = Integer.MIN_VALUE;
       Set<Integer> numSet = new HashSet<>();
       for (int num : arr) {
           if (num < min) min = num;
           if (num > max) max = num;
           numSet.add(num);
       }
       if ((max - min) % (n - 1) != 0) {
           return false;
       }
       int diff = (max - min) / (n - 1);
       if (diff == 0) {
           return true;
       }
       int current = min;
       for (int i = 0; i < n; i++) {
           if (!numSet.contains(current)) {
               return false;
           }
           current += diff;
       }        
       return true;
   }
}
