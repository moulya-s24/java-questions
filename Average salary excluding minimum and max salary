public class Main {
   public static void main(String[] args) {
       Solution solution = new Solution();
       int[] salary1 = {4000, 3000, 1000, 2000};
       System.out.println("Salaries: " + Arrays.toString(salary1));
       System.out.println("Average (excl. min/max): " + solution.average(salary1) + "\n");
       int[] salary2 = {1000, 2000, 3000};
       System.out.println("Salaries: " + Arrays.toString(salary2));
       System.out.println("Average (excl. min/max): " + solution.average(salary2));
   }
}
class Solution {
   public double average(int[] salary) {
       int min = Integer.MAX_VALUE;
       int max = Integer.MIN_VALUE;
       int sum = 0;
       for (int s : salary) {
           sum += s;
     if (s < min) min = s;
           if (s > max) max = s;
       }
       int adjustedSum = sum - min - max;
       return (double) adjustedSum / (salary.length - 2);
   }
}
 
