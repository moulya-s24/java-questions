public class Main {
   public static void main(String[] args) {
       Solution solution = new Solution();
       String[] sentences1 = {
           "alice and bob love leetcode",
           "i think so too",
           "this is great thanks very much"
       };
       System.out.println("Maximum words: " + solution.mostWordsFound(sentences1));
       String[] sentences2 = {
           "please wait",
           "continue to fight",
           "continue to win"
       };
       System.out.println("Maximum words: " + solution.mostWordsFound(sentences2));
   }
}
 
class Solution {
   public int mostWordsFound(String[] sentences) {
       int maxWords = 0;
       
       for (String sentence : sentences) {
           String[] words = sentence.split(" ");
           
           if (words.length > maxWords) {
               maxWords = words.length;
           }
       }
       
       return maxWords;
   }
}
