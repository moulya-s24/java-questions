import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;
public class Main {
   public static void main(String[] args) {
       Solution solution = new Solution();
       List<List<String>> items = new ArrayList<>();
       items.add(Arrays.asList("phone", "blue", "pixel"));
       items.add(Arrays.asList("computer", "silver", "lenovo"));
       items.add(Arrays.asList("phone", "gold", "iphone"));
       String ruleKey1 = "color";
       String ruleValue1 = "silver";
       System.out.println("Rule: " + ruleKey1 + " = " + ruleValue1);
       System.out.println("Matching items: " + solution.countMatches(items, ruleKey1, ruleValue1) + "\n");
       String ruleKey2 = "type";
       String ruleValue2 = "phone";
       System.out.println("Rule: " + ruleKey2 + " = " + ruleValue2);
       System.out.println("Matching items: " + solution.countMatches(items, ruleKey2, ruleValue2));
   }
}
class Solution {
   public int countMatches(List<List<String>> items, String ruleKey, String ruleValue) {
       int indexToCheck = 0;
       if (ruleKey.equals("color")) {
           indexToCheck = 1;
       } else if (ruleKey.equals("name")) {
           indexToCheck = 2;
       }
       int matchCount = 0;
       for (List<String> item : items) {
           if (item.get(indexToCheck).equals(ruleValue)) {
               matchCount++;
           }
       }
       return matchCount;
   }
}
