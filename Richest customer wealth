import java.util.Arrays;
public class Main {
   public static int maximumWealth(int[][] accounts) {
       int maxWealth = 0;  
       for (int i = 0; i < accounts.length; i++) {
           int currentCustomerWealth = 0;
                 for (int j = 0; j < accounts[i].length; j++) {
             currentCustomerWealth += accounts[i][j];
           }
           if (currentCustomerWealth > maxWealth) {
               maxWealth = currentCustomerWealth;
           }
       }    
       return maxWealth;
   }
   public static void main(String[] args) {
       int[][] accounts = {
           {1, 2, 3},
           {3, 2, 1},  
           {2, 8, 7}  
       };
       System.out.println("Accounts Matrix: " + Arrays.deepToString(accounts));      
       int richestWealth = maximumWealth(accounts);      
       System.out.println("Richest Customer Wealth: " + richestWealth);
   }
}
