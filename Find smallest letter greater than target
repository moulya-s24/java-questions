import java.util.Arrays;
public class Main {
   public static void main(String[] args) {
       Solution solution = new Solution();
       char[] letters1 = {'c', 'f', 'j'};
       char target1 = 'a';
       System.out.println("Letters: " + Arrays.toString(letters1) + ", Target: '" + target1 + "'");
       System.out.println("Result: '" + solution.nextGreatestLetter(letters1, target1) + "'\n");
       char[] letters2 = {'c', 'f', 'j'};
       char target2 = 'c';
       System.out.println("Letters: " + Arrays.toString(letters2) + ", Target: '" + target2 + "'");
       System.out.println("Result: '" + solution.nextGreatestLetter(letters2, target2) + "'\n");
       char[] letters3 = {'x', 'y', 'y', 'z'};
       char target3 = 'z';
       System.out.println("Letters: " + Arrays.toString(letters3) + ", Target: '" + target3 + "'");
       System.out.println("Result: '" + solution.nextGreatestLetter(letters3, target3) + "'");
   }
}
 
class Solution {
   public char nextGreatestLetter(char[] letters, char target) {
       int left = 0;
       int right = letters.length - 1;
       while (left <= right) {
           int mid = left + (right - left) / 2;  
           if (letters[mid] <= target) {
               left = mid + 1;
           } else {
               right = mid - 1;
           }
       }
       return letters[left % letters.length];
   }
}
